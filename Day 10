Leetcode question 997
class Solution {
    public int findJudge(int n, int[][] trust) {
        // Track the net trust score for each person (1-indexed)
        int[] trustScore = new int[n + 1];

        for (int[] relation : trust) {
            int personA = relation[0];
            int personB = relation[1];
            
            trustScore[personA]--; // personA trusts someone -> lose 1 point
            trustScore[personB]++; // personB is trusted -> gain 1 point
        }

        // The judge must have a net trust score of exactly n - 1
        for (int i = 1; i <= n; i++) {
            if (trustScore[i] == n - 1) {
                return i;
            }
        }

        return -1;
    }
}
Leetcode question 1791
class Solution {
    public int findCenter(int[][] edges) {
        // Compare the nodes of the first edge with the second edge
        if (edges[0][0] == edges[1][0] || edges[0][0] == edges[1][1]) {
            return edges[0][0];
        }
        return edges[0][1];
    }
}
